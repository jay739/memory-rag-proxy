# Required
MEMORY_DIR=/path/to/your/markdown/notes

# Optional (defaults shown)
EMBED_UPSTREAM=http://127.0.0.1:11434
PRIMARY_UPSTREAM=http://127.0.0.1:11434
FALLBACK_UPSTREAM=http://127.0.0.1:11434
HEALTH_TIMEOUT_S=2
HEALTH_CACHE_TTL_S=45
PROXY_PORT=11435
EMBED_MODEL=nomic-embed-text
TOP_K=3
SIM_THRESHOLD=0.5

# Optional: OpenAI-compatible upstreams (e.g. MLX servers), comma-separated
MLX_UPSTREAMS=

# Optional: one alias name mapped to an ordered list of host|model candidates,
# tried in order until one is reachable. Multiple aliases separated by ";".
MODEL_ALIASES=general-purpose=http://gpu-box.local:11434|qwen2.5:7b-instruct,http://mac-mini.local:8080/v1|mlx-community/Qwen2.5-7B-Instruct-4bit
